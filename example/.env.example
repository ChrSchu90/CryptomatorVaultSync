# Cryptomator Vault Sync example environment file
# Copy this file to .env and adjust the values for your setup.

# Required unless CRYPTOMATOR_VAULT_PASSWORD_FILE is used.
# If both are set, CRYPTOMATOR_VAULT_PASSWORD takes precedence.
#CRYPTOMATOR_VAULT_PASSWORD=MyVaultPassword

# Recommended: store the vault password in a file mounted via /config:ro.
CRYPTOMATOR_VAULT_PASSWORD_FILE=/config/vault-password

# Empty = one-shot mode.
# Example scheduled mode: SYNC_CRON=*/5 * * * *
# For Docker Compose, cron expressions are often clearer directly in the compose file:
# SYNC_CRON=*/5 * * * *
SYNC_CRON=

# Only enable if /sync is the authoritative source.
# Use DRY_RUN=true first to review deletions.
RSYNC_DELETE=false

# Optional dry-run mode. Does not write to the vault and skips upstream sync.
DRY_RUN=false

# Optional rsync exclude file.
# Leave empty or remove if not used.
RSYNC_EXCLUDE_FILE=/config/rsync-exclude.txt

# Optional upstream sync via rclone.
UPSTREAM_ENABLED=false
UPSTREAM_MODE=sync
UPSTREAM_DESTINATIONS=remote:CryptomatorVault
UPSTREAM_CONFIG=/config/rclone.conf
UPSTREAM_FAIL_ACTION=exit
UPSTREAM_START_DELAY_SECONDS=0

# Optional timezone for log timestamps.
TZ=Europe/Berlin