# Cryptomator Vault Sync example environment file
# Copy this file to .env and adjust the values for your setup.


# ==============================================================================
# Runtime user and permissions
# ==============================================================================

# Optional [default=1000] User ID used to run the sync process.
PUID=1000

# Optional [default=1000] Group ID used to run the sync process.
PGID=1000

# Optional [default=022] File creation mask used by the sync process.
# 022 is suitable for most single-user setups.
# 002 can be useful on NAS/shared-folder setups where group-write access is required.
UMASK=022

# Optional timezone for log timestamps.
TZ=Europe/Berlin


# ==============================================================================
# Cryptomator vault
# ==============================================================================

# Required unless CRYPTOMATOR_VAULT_PASSWORD_FILE is used.
# If both are set, CRYPTOMATOR_VAULT_PASSWORD takes precedence.
#CRYPTOMATOR_VAULT_PASSWORD=MyVaultPassword

# Recommended: store the vault password in a file mounted via /config:ro.
# Required unless CRYPTOMATOR_VAULT_PASSWORD is used.
CRYPTOMATOR_VAULT_PASSWORD_FILE=/config/vault-password

# Optional [default=fuse] Mount mode for the Cryptomator vault.
# Supported values:
# - fuse:   Mounts the vault via FUSE and syncs files with rsync.
# - webdav: Starts the Cryptomator WebDAV endpoint. Sync via WebDAV is not supported yet.
CRYPTOMATOR_MOUNT_MODE=fuse

# Optional [default=false] Fix encrypted vault permissions after sync.
# Useful for NAS/shared-folder setups where the vault is also accessed from another device.
CRYPTOMATOR_VAULT_FIX_PERMISSIONS=false

# Optional [default=60] Maximum time in seconds to wait for the vault mount or WebDAV endpoint.
MOUNT_TIMEOUT_SECONDS=60


# ==============================================================================
# Sync schedule
# ==============================================================================

# Optional [default=] Cron schedule for scheduled sync mode.
# Empty = one-shot mode.
# Example: run every hour:
# SYNC_CRON=0 * * * *
SYNC_CRON=


# ==============================================================================
# Local sync options
# ==============================================================================

# Optional [default=false] Dry-run mode.
# Does not write to the vault and skips upstream sync.
DRY_RUN=false

# Optional [default=false] Delete files from the vault that no longer exist in /sync.
# Only enable if /sync is the authoritative source.
# Use DRY_RUN=true first to review deletions.
RSYNC_DELETE=false

# Optional [default=false] Use rsync --inplace.
# Can be useful for some special filesystems, but is usually not needed with FUSE.
RSYNC_INPLACE=false

# Optional [default=] Additional rsync arguments.
# Be aware that arguments are logged for debugging.
RSYNC_EXTRA_ARGS=

# Optional [default=] Path to an rsync exclude file inside the container.
# Leave empty if not used.
# Example: /config/rsync-exclude.txt
RSYNC_EXCLUDE_FILE=/config/rsync-exclude.txt


# ==============================================================================
# Hook scripts
# ==============================================================================

# Optional [default=] Executable script path inside the container.
# Runs as PUID:PGID before the vault is mounted and synced.
# Example: /config/before-sync.sh
BEFORE_SYNC_SCRIPT=

# Optional [default=] Executable script path inside the container.
# Runs as PUID:PGID after sync, permission fix, and upstream sync.
# Example: /config/after-sync.sh
AFTER_SYNC_SCRIPT=


# ==============================================================================
# Upstream sync via rclone
# ==============================================================================

# Optional [default=false] Enable upstream sync of the encrypted vault via rclone.
UPSTREAM_ENABLED=false

# Optional [default=sync] rclone operation used for upstream sync.
# Supported values:
# - sync: Make destination match the encrypted vault.
# - copy: Copy/update files without deleting extra destination files.
UPSTREAM_MODE=sync

# Required when UPSTREAM_ENABLED=true.
# One or more rclone destinations separated by |.
# Example: remote:CryptomatorVault
# Example: remote-a:Vault|remote-b:Vault
UPSTREAM_DESTINATIONS=remote:CryptomatorVault

# Optional [default=/config/rclone.conf] rclone config file path inside the container.
UPSTREAM_CONFIG=/config/rclone.conf

# Optional [default=false] Run rclone check after upstream sync/copy.
# Increases runtime and provider API usage.
UPSTREAM_CHECK=false

# Optional [default=continue] What to do when upstream sync fails.
# Supported values:
# - continue: Mark upstream error but keep the container/scheduler running.
# - exit:     Exit with an error.
UPSTREAM_FAIL_ACTION=continue

# Optional [default=0] Delay in seconds before starting upstream sync.
# Can be useful when the encrypted vault is stored in a folder watched by another sync tool.
UPSTREAM_START_DELAY_SECONDS=0
